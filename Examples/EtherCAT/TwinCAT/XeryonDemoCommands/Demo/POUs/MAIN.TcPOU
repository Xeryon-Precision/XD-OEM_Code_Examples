		END_IF
	15:
		IF(NOT drive3JogN) THEN
			drive3State := 16;
		END_IF
	16:
		IF(Drive3.Halt() <>  XeryonDriveStatus.Waiting) THEN
			drive3State := 0;
		END_IF		
		
END_CASE

IF(drive3Halt) THEN
	Drive3.Halt();
END_IF
IF(drive3Stop) THEN
	Drive3.Stop();
END_IF
IF(drive3Enable <> drive3EnableOld) THEN
	IF(Drive3.Enable(drive3Enable) <> XeryonDriveStatus.Waiting) THEN
		drive3EnableOld := drive3Enable;	
	END_IF
END_IF
IF(drive3Reset) THEN
	Drive3.Reset();
END_IF




// DEMO Drive 4
CASE drive4State OF
	0:
		IF(drive4JogP) THEN
			drive4State := 10;
		END_IF
		IF(drive4JogN) THEN
			drive4State := 14;
		END_IF
		IF(drive4Init) THEN
			drive4State := 9;
		END_IF
		IF(drive4MoveAbs) THEN
			drive4State := 2;
		END_IF
		IF(drive4Index) THEN
			drive4State := 1;
		END_IF
		IF(drive4Dpos) THEN
			drive4State := 8;
		END_IF
	1:
		IF(NOT drive4Index) THEN
