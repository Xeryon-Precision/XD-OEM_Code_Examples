	IF(Drive4.Enable(drive4Enable) <> XeryonDriveStatus.Waiting) THEN
		drive4EnableOld := drive4Enable;	
	END_IF
END_IF
IF(drive4Reset) THEN
	Drive4.Reset();
END_IF


target_max := 1843200;
target_min := -1843200;

speed_min := 0;
speed_max := 1000000;


acc_min := 0;
acc_max := 65535;

dec_min := 0;
dec_max := 65535;]]></ST>
